{
  "manifest_version": 3,
  "name": "Instagram Following",
  "version": "1.0.0",
  "description": "Skip For you. Always open Instagram's main feed in Following.",
  "icons": {
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png",
    "1024": "icons/icon-1024.png"
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "following_feed",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
